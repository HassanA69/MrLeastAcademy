@model List<Department>
@{
    ViewData["Title"] = "All Department";
}

<h1>All Department</h1>
<table class="table tabe-hover table-bordered">
    <tr>
        <th>No.</th>
        <th>Name</th>
    </tr>
    @foreach(var dep in Model)
    {
        <tr>
            <td>@dep.Id</td>
            <td>@dep.Name</td>

        </tr>
    }
</table>
<a href="/department/add" class=" btn btn-outline-success">Add Department</a>