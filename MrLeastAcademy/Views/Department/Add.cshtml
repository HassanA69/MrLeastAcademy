@model Department
@{
    ViewData["Title"] = "Add";
}

<h1>Add Department </h1>

<form asp-action="saveAdd" >
        <div>
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form form-control"  />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="ManagerName"></label>
            <input asp-for="ManagerName" class="form form-control"  />
            <span asp-validation-for="ManagerName" class="text-danger"></span>

        </div>
    <div class="mt-3">
        <input type="submit" value="Create" class="btn btn-outline-success me-2" />
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
</form>
