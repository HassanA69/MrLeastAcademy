@using MrLeastAcademy.ViewModel
@model EmployeeCustomDataViewModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Employee</h1>

<form asp-action="saveEdit" asp-route-Id="@Model.Id" method="post" >
    <div class="form-group">
      
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form= form-control " />
    </div>
    <div class="form-group">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form= form-control " />
    </div>
    <div class="form-group">
        <label asp-for="Salary"></label>
        <input asp-for="Salary" class="form= form-control " />
    </div>
    <div class="form-group">
        <label asp-for="JobTitle"></label>
        <input asp-for="JobTitle" class="form= form-control " />
    </div>
    <div class="form-group">
        <label asp-for="ImageUrl"></label>
        <input asp-for="ImageUrl" class="form= form-control " />
    </div>
    <div> 
         <label asp-for="DepartmentId" class="form-label"></label>
        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
           
        </select>

     </div>

    <div class="mt-3">
        <input type="submit" value="Save" class="btn btn-outline-success me-2" />
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
</form>

                     