@using MrLeastAcademy.ViewModel
@model EmployeeCustomDataViewModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<form action="/employee/saveEdit/@Model.Id" method="post" >
    <div class="form-group">
        <label for="name">Name</label>
        <input type="text" class="form-control" id="Name" name="Name" value="@Model?.Name" />
    </div>
    <div class="form-group">
        <label for="Address">Address</label>
        <input type="text" class="form-control" id="Address" name="Address" value="@Model?.Address" />
    </div>
    <div class="form-group">
        <label for="salary">Salary</label>
        <input type="number" class="form-control" id="Salary" name="Salary" value="@Model?.Salary" />
    </div>
    <div class="form-group">
        <label for="JobTitle">Job Title</label>
        <input type="text" class="form-control" id="JobTitle" name="JobTitle" value="@Model?.JobTitle" />
    </div>
    <div class="form-group">
        <label for="ImageUrl">Image Url</label>
        <input type="text" class="form-control" id="ImageUrl" name="ImageUrl" value="@Model?.ImageUrl" />
    </div>
    <div>
        <label for="DepartmentId">Department</label>
        <select id="DepartmentId" name="DepartmentId" class="form-select" aria-label="Default select example">
            @foreach (var dept in Model?.Departments)
            {
                if (dept.Id == Model.DepartmentId)
                {
                    <option value="@dept.Id" selected>@dept.Name</option>

                }
                else
                {
                    <option value="@dept.Id">@dept.Name</option>

                }

            }

        </select>
    </div>

    <input type="submit" value="Save" class="btn btn-primary" />
</form>