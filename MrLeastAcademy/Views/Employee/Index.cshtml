@model List<Employee>
@{
    ViewData["Title"] = "Index";
}

<h1>All Employees</h1>

<table class="table table-bordered table-hover">

    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Salary</th>
        <th>Address</th>
        <th></th>
    </tr>
    @foreach(var emp in Model)
    {
        <tr>
            <td>@emp.Id</td>
            <td>@emp.Name</td>
            <td>@emp.Salary</td>
            <td>@emp.Address</td>
            <td><a asp-action="edit" asp-route-Id="@emp.Id" class="btn btn-outline-warning">Edit</a>
                <form asp-action="Delete" asp-route-id="@emp.Id" method="post" style="display:inline;">
                    <button type="submit" class="btn btn-outline-danger"
                            onclick="return confirm('Are you sure you want to delete @emp.Name ?');">
                        Delete
                    </button>
                </form>
            </td>
        </tr>
    }
</table>
<a asp-action="new" asp-controller="Employee" class="btn btn-primary">New Employee</a>
