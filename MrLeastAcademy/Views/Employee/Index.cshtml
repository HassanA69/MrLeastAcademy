@model List<Employee>
@{
    ViewData["Title"] = "Index";
}

<h1>All Employees</h1>

<table class="table table-bordered table-hover">

    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Salary</th>
        <th>Address</th>
        <th></th>
    </tr>
    @foreach(var emp in Model)
    {
        <tr>
            <td>@emp.Id</td>
            <td>@emp.Name</td>
            <td>@emp.Salary</td>
            <td>@emp.Address</td>
            <td><a href="/employee/edit/@emp.Id" class="btn btn-outline-warning">Edit</a> <a href="/employee/delete/@emp.Id" class="btn btn-outline-danger">Delete</a></td>
        </tr>
    }
</table>